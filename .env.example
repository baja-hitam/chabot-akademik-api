# ════════════════════════════════════════════════════════════════════════════════════
# Academic AI Chatbot - Environment Variables Configuration
# ════════════════════════════════════════════════════════════════════════════════════
# 
# DUAL LLM SUPPORT: Choose between Local Ollama or Groq Cloud API
# 
# ════════════════════════════════════════════════════════════════════════════════════

# ─── LLM PROVIDER SELECTION ───────────────────────────────────────────────────────
# Choose which LLM provider to use:
#   - "local"  → Ollama (runs locally, requires Ollama server)
#   - "groq"   → Groq Cloud API (requires internet, API key)
LLM_PROVIDER=local

# ─── OPTION 1: LOCAL OLLAMA ──────────────────────────────────────────────────────
# Use these when LLM_PROVIDER=local
# 
# Setup:
#   1. Install Ollama from https://ollama.ai
#   2. Run: ollama serve
#   3. Pull a model: ollama pull llama3.2:3b
#      (alternatives: mistral, neural-chat, dolphin-phi, gemma, etc.)
#
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2:3b

# ─── OPTION 2: GROQ CLOUD API ────────────────────────────────────────────────────
# Use these when LLM_PROVIDER=groq
# 
# Setup:
#   1. Go to https://console.groq.com
#   2. Create account and generate API key
#   3. Replace placeholder with your actual API key below
#
GROQ_API_KEY=gsk_your_groq_api_key_here_replace_this
GROQ_MODEL_NAME=mixtral-8x7b-32768
# Alternative Groq models: llama2-70b-4096, gemma-7b-it, llama-3-70b-versatile

# ─── EMBEDDING MODEL ─────────────────────────────────────────────────────────────
# Used for vectorizing documents in ChromaDB
# BAAI/bge-m3 provides good Indonesian language support
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ─── CHROMADB CONFIGURATION ──────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=academic_docs

# ─── DOCUMENT PROCESSING ─────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── RAG CONFIGURATION ────────────────────────────────────────────────────────────
TOP_K_RESULTS=5

# ─── APPLICATION ──────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ─── CORS (comma-separated origins) ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── UPLOAD DIRECTORY ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── OCR SETTINGS ─────────────────────────────────────────────────────────────────
# DPI for PDF rendering (OCR pipeline)
# 150 DPI: balanced accuracy and file size (~1-2 MB per page)
# 200-250 DPI: better accuracy for small text (larger files)
OCR_DPI=150
