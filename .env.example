# ============================================
# Academic AI Chatbot - Environment Variables
# ============================================

# ─── LLM PROVIDER SELECTION ───────────────────────────────────────────────────────
# Choose which LLM provider to use:
#   - "local"  → Ollama (runs locally, requires Ollama server)
#   - "groq"   → Groq Cloud API (requires internet, API key)
LLM_PROVIDER=local

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1:8b
# Model vision untuk OCR PDF bergambar (harus mendukung input gambar di Ollama)
# Pilihan: gemma4:e4b, llava, moondream, llava-phi3
# Kosongkan ("") untuk menonaktifkan dan gunakan doctr sebagai fallback
OLLAMA_VISION_MODEL=gemma3:4b

# Konfigurasi Database PostgreSQL
# Format: postgresql://<username>:<password>@<host>:<port>/<nama_database>
POSTGRES_URL=postgresql://postgres:11010112@localhost:5432/chatbot_akademik

# Kunci Rahasia untuk Autentikasi JWT
JWT_SECRET_KEY=a8106401cffa9186b9712e401707abac0b1e6d888a11ee638c10380110335db0

#groq Configuration
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=academic_docs

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Configuration
USE_RERANKER=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
TOP_K_RETRIEVE=30
TOP_K_RESULTS=6

# Application
APP_HOST=localhost
APP_PORT=8000
APP_DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
